# ─── Database ────────────────────────────────────────────────────────────────
# Neon (or any Postgres) connection string.
# Without this the app falls back to an in-process PGLite instance (data is
# lost on every restart). Set this on Vercel for a persistent database.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Random 32-byte hex secret used to sign session tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace_with_32_byte_hex_secret

# The canonical public URL of your deployed app (no trailing slash).
# Better Auth uses this as the OAuth redirect_uri base.
BETTER_AUTH_URL=https://your-app.vercel.app

# ─── Grok Auth broker (OAuth federation) ─────────────────────────────────────
# Injected automatically by the Grok platform on deploy — do not set manually
# unless you're configuring a custom deployment outside the Grok dashboard.
# GROK_AUTH_ISSUER=https://grok.com
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# ─── Email / Password reset ───────────────────────────────────────────────────
# Resend API key — get one free at https://resend.com
# Without this key, password-reset emails are only logged to the server console
# (useful for local dev; not useful in production).
RESEND_API_KEY=re_your_resend_api_key_here

# The "From" address shown on password-reset emails.
# Must be a verified domain in your Resend account.
# Defaults to: Rollbook <noreply@rollbook.app>
RESEND_FROM_EMAIL=Rollbook <noreply@yourdomain.com>

# ─── Auth toggle ──────────────────────────────────────────────────────────────
# Set to "true" to enable real sign-in (required when DATABASE_URL is set).
# The Grok platform sets this automatically on deploy.
VITE_AUTH_ENABLED=true

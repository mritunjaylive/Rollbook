# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Build output ─────────────────────────────────────────────────────────────
dist/
.vercel/
.output/

# ─── Test & Coverage output ───────────────────────────────────────────────────
coverage/
*.lcov
test-results/
playwright-report/
blob-report/

# ─── Environment / secrets ────────────────────────────────────────────────────
# Never commit real env files — use .env.example as the template
.env
.env.*
!.env.example

# ─── Sandbox-internal files (Grok App Builder) ────────────────────────────────
.grok/
.project_id
.node_modules.lock
startup.sh
AGENTS*.md
artifacts/

# ─── QA screenshots (generated at runtime) ───────────────────────────────────
screenshots/*
# keep the directory itself so CI can write into it
!screenshots/.gitkeep

# ─── Framework / tooling caches ───────────────────────────────────────────────
.tanstack/
.nitro/
.cache/
.vite/

# TanStack Router auto-generated file — regenerated on every dev/build run
src/routeTree.gen.ts

# ─── OS / editor noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
*.swp
*.swo
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Database files ───────────────────────────────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ─── Archives / exports ───────────────────────────────────────────────────────
# e.g. rollbook.zip created when zipping the project for sharing
*.zip
*.tar.gz
*.tgz

# ─── Profiling output ─────────────────────────────────────────────────────────
# generated by `node --cpu-prof` (referenced in Vite build logs)
*.cpuprofile
isolate-*.log
